@page "{AccountId=0}"
@using Comet.Web.App.Services
@inject LanguageService Language
@model Comet.Web.App.Areas.Panel.Pages.User.ChangePasswordModel
@{
    ViewData["Title"] = Language.GetString("ChangePasswordPageTitle", Model.Username);
}

<form method="post">
        <div asp-validation-summary="All"></div>
        <div class="youplay-input">
            <input asp-for="Input.Password" placeholder="@Language.GetString("NewPassword")">
        </div>
        <div class="youplay-input">
            <input asp-for="Input.ConfirmPassword" placeholder="@Language.GetString("ConfirmPassword")">
        </div>
        <button type="submit" class="btn btn-primary">@Language.GetString("Submit")</button>
        <a asp-area="Panel" asp-page="/User/Accounts" class="btn btn-danger">@Language.GetString("GoBack")</a>
    </form>