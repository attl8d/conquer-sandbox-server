@page
@using Comet.Web.App.Areas.Profile.Models
@using Comet.Web.App.Services
@using System.Security.Claims
@inject LanguageService Language
@model Comet.Web.App.Areas.Profile.Pages.Settings.IndexModel
@{
    ViewData["title"] = Language.GetString("ProfileSettings");
}

@await Html.PartialAsync("_ProfileHeader", Model.Profile)

<div class="container youplay-content">
    <div class="row">
        <div class="col-md-9">
            <ul class="pagination pagination-sm mt-0">
                <li class="active">
                    <a asp-area="Profile" asp-page="/Settings/Index">@Language.GetString("Profile")</a>
                </li>
                <li>
                    <a asp-area="Profile" asp-page="/Settings/Security">@Language.GetString("Security")</a>
                </li>
                <li>
                    <a asp-area="Profile" asp-page="/Settings/Regional">@Language.GetString("Regional")</a>
                </li>
                <li>
                    <a asp-area="Profile" asp-page="/Settings/Privacy">@Language.GetString("Privacy")</a>
                </li>
                <li>
                    <a asp-area="Profile" asp-page="/Settings/Notifications">@Language.GetString("Notifications")</a>
                </li>
            </ul>

            <h3>@Language.GetString("Profile")</h3>
            <p>@Language.GetString("ProfileDisclaimer")</p>
            <form method="post">
                <div class="form-horizontal mt-30 mb-40">
                    <div class="form-group">
                        <label class="control-label col-sm-3">@Language.GetString("UserName"):</label>
                        <div class="col-sm-9">
                            @Model.User.FindFirst(ClaimTypes.Name)?.Value
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-sm-3">@Language.GetString("Email"):</label>
                        <div class="col-sm-9">
                            @Model.User.FindFirst(ClaimTypes.Email)?.Value
                            <a class="btn btn-sm btn-success" asp-area="Profile" asp-page="/Settings/Security">@Language.GetString("ChangeEmail")</a>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-sm-3">@Language.GetString("Password"):</label>
                        <div class="col-sm-9">
                            ******
                            <a class="btn btn-sm btn-success" asp-area="Profile" asp-page="/Settings/Security">@Language.GetString("ChangePassword")</a>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-sm-3">@Language.GetString("AccountType"):</label>
                        <div class="col-sm-9">
                            @Language.GetString(User.FindFirst(ClaimTypes.Role)?.Value)
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-sm-3">@Language.GetString("BirthDate"):</label>
                        <div class="col-sm-9">
                            <div class="youplay-input">
                                <input asp-for="Input.DateOfBirth" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-sm-3">@Language.GetString("Gender"):</label>
                        <div class="col-sm-9">
                            <div class="youplay-select">
                                <select asp-for="Input.Gender">
                                    <option value=""></option>
                                    <option value="M">Masculino</option>
                                    <option value="F">Feminino</option>
                                    <option value="O">Outro</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-sm-3">@Language.GetString("Pronoun"):</label>
                        <div class="col-sm-9">
                            <div class="youplay-input">
                                <input asp-for="Input.Pronoun" class="youplay-input" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-sm-3">@Language.GetString("Location"):</label>
                        <div class="col-sm-9">
                            <div class="youplay-input">
                                <input asp-for="Input.Locality" class="youplay-input" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-sm-offset-3 col-sm-9">
                            <button type="submit" class="btn btn-default">@Language.GetString("SaveSettings")</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <!-- Right Side -->
        <div class="col-md-3">
            @if (!string.IsNullOrEmpty(Model.Profile.AboutMe))
            {
                <div class="side-block">
                    <h4 class="block-title">@Language.GetString("AboutMe")</h4>
                    <div class="block-content"> @Model.Profile.AboutMe </div>
                </div>
            }
        </div>
        <!-- Right Side -->
    </div>
</div>

@section Scripts
{
<script>
    const phoneOpt = {
        onKeyPress: function(phone, e, field, options) {
            let masks = ['(00) 0000-00009', '(00) 00000-0000'];
            let mask = (phone.replace(/\D/g, '').length === 11) ? masks[1] : masks[0];
            $('#new_phone').mask(mask, phoneOpt);
        }
    };
    $('#new_phone').mask('(00) 0000-0000', phoneOpt);
</script>
}