@page
@using Comet.Web.App.Services
@inject LanguageService Language
@model Comet.Web.App.Areas.Profile.Pages.Settings.SecurityModel
@{
    ViewData["Title"] = Language.GetString("ProfileSettings");
}

@await Html.PartialAsync("_ProfileHeader", Model.Profile)

<div class="container youplay-content">
    <div class="row">
        <div class="col-md-9">
            <ul class="pagination pagination-sm mt-0">
                <li>
                    <a asp-area="Profile" asp-page="/Settings/Index">@Language.GetString("Profile")</a>
                </li>
                <li class="active">
                    <a asp-area="Profile" asp-page="/Settings/Security">@Language.GetString("Security")</a>
                </li>
                <li>
                    <a asp-area="Profile" asp-page="/Settings/Regional">@Language.GetString("Regional")</a>
                </li>
                <li>
                    <a asp-area="Profile" asp-page="/Settings/Privacy">@Language.GetString("Privacy")</a>
                </li>
                <li>
                    <a asp-area="Profile" asp-page="/Settings/Notifications">@Language.GetString("Notifications")</a>
                </li>
            </ul>

            <div asp-validation-summary="All" class="text-danger"></div>

            <partial name="_StatusMessage" model="Model.StatusMessage" />

            @if (Model.HasPassword)
            {
                <h3>@Language.GetString("ChangePassword"):</h3>
                <form asp-page-handler="ChangePassword">
                    <div class="form-horizontal mt-30 mb-40">
                        <div class="form-group">
                            <label class="control-label col-sm-3" for="cur_password">@Language.GetString("CurrentPassword"):</label>
                            <div class="col-sm-9">
                                <div class="youplay-input">
                                    <input asp-for="PasswordInput.OldPassword" placeholder="@Language.GetString("CurrentPassword")">
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-sm-3" for="new_password">@Language.GetString("NewPassword"):</label>
                            <div class="col-sm-9">
                                <div class="youplay-input">
                                    <input asp-for="PasswordInput.NewPassword" placeholder="@Language.GetString("NewPassword")">
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-sm-3" for="new_password_confirm">@Language.GetString("ConfirmNewPassword"):</label>
                            <div class="col-sm-9">
                                <div class="youplay-input">
                                    <input asp-for="PasswordInput.ConfirmPassword" placeholder="@Language.GetString("ConfirmNewPassword")">
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-offset-3 col-sm-9">
                                <button type="submit" class="btn btn-default">@Language.GetString("ChangePassword")</button>
                            </div>
                        </div>
                    </div>
                </form>

                if (Model.Profile.TwoFactorEnabled)
                {
                    <a asp-area="Profile" asp-page="/Settings/TwoFactorAuthentication" class="btn btn-default">@Language.GetString("TwoFactorAuthentication")</a>
                }
                else
                {
                    <a asp-area="Profile" asp-page="/Settings/EnableAuthenticator" class="btn btn-default">@Language.GetString("EnableAuthenticator")</a>
                }
            }
            else
            {
                <h3>@Language.GetString("SetPassword"):</h3>
                <form asp-page-handler="SetPassword">
                    <div class="form-horizontal mt-30 mb-40">
                        <div class="form-group">
                            <label class="control-label col-sm-3" for="new_password">@Language.GetString("NewPassword"):</label>
                            <div class="col-sm-9">
                                <div class="youplay-input">
                                    <input asp-for="SetPasswordInput.NewPassword" placeholder="@Language.GetString("NewPassword")">
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-sm-3" for="new_password_confirm">@Language.GetString("ConfirmNewPassword"):</label>
                            <div class="col-sm-9">
                                <div class="youplay-input">
                                    <input asp-for="SetPasswordInput.ConfirmPassword" placeholder="@Language.GetString("ConfirmNewPassword")">
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-offset-3 col-sm-9">
                                <button type="submit" class="btn btn-default">@Language.GetString("SetPassword")</button>
                            </div>
                        </div>
                    </div>
                </form>
            }
            
            <h3>@Language.GetString("ChangeEmail"):</h3>
            <form asp-page-handler="ChangeEmail">
                <div class="form-horizontal mt-30 mb-40">
                    <div class="form-group">
                        <label class="control-label col-sm-3">@Language.GetString("CurrentEmail"):</label>
                        <div class="col-sm-9">
                            @Model.Profile.Email
                            @if (Model.Profile.EmailConfirmed)
                            {
                                <span class="glyphicon glyphicon-ok text-success"></span>
                            }
                            else
                            {
                                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link">@Language.GetString("SendVerificationEmail")</button>
                            }
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-sm-3" for="new_email">@Language.GetString("NewEmail"):</label>
                        <div class="col-sm-9">
                            <div class="youplay-input">
                                <input asp-for="EmailInput.NewEmail" placeholder="@Language.GetString("NewEmail")">
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-sm-offset-3 col-sm-9">
                            <button type="submit" class="btn btn-default">@Language.GetString("ChangeEmail")</button>
                        </div>
                    </div>
                </div>
            </form>

            @if (Model.CurrentLogins?.Count > 0)
            {
                <h4>@Language.GetString("RegisteredLogins")</h4>
                <table class="table">
                    <tbody>
                        @foreach (var login in Model.CurrentLogins)
                        {
                            <tr>
                                <td id="@($"login-provider-{login.LoginProvider}")">@login.ProviderDisplayName</td>
                                <td>
                                    @if (Model.ShowRemoveButton)
                                    {
                                        <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post">
                                            <div>
                                                <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                                <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                                <button type="submit" class="btn btn-default" title="Remove this @login.LoginProvider login from your account">
                                                    @Language.GetString("Remove")
                                                </button>
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        @: &nbsp;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (Model.OtherLogins?.Count > 0)
            {
                <h4>@Language.GetString("AddAnotherLoginService")</h4>
                <hr />
                <form id="link-login-form" asp-page-handler="LinkLogin" method="post" class="form-horizontal">
                    <div id="socialLoginList">
                        <p>
                            @foreach (var provider in Model.OtherLogins)
                            {
                                <button id="@($"link-login-button-{provider.Name}")" type="submit" class="btn btn-default" name="provider" value="@provider.Name" title="@Language.GetString("Sigin3rdPartyAccount", provider.DisplayName)">@provider.DisplayName</button>
                            }
                        </p>
                    </div>
                </form>
            }
        </div>
        <!-- Right Side -->
        <div class="col-md-3">
            @if (!string.IsNullOrEmpty(Model.Profile.AboutMe))
            {
                <div class="side-block">
                    <h4 class="block-title">@Language.GetString("AboutMe")</h4>
                    <div class="block-content"> @Model.Profile.AboutMe </div>
                </div>
            }
        </div>
        <!-- Right Side -->
    </div>
</div>

@section Scripts
{

}